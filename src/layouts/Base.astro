---
import '../styles/global.css';
import { PROFILE } from '../data/career';
import ArchitecturalManifold from '../components/ArchitecturalManifold.astro';

interface Props {
  title?: string;
  description?: string;
  shellClass?: string;
  showManifold?: boolean;
}

const {
  title = `${PROFILE.displayName} (${PROFILE.alias}) — Head of Architecture`,
  description = 'Head of Architecture. Designing resilient cloud foundations, AI-native engineering lifecycles, and internal developer platforms.',
  shellClass = 'monograph-shell',
  showManifold = true,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-type="software">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3F00FF" />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="software" />

    <!-- Open Graph & Canonical -->
    <link rel="canonical" href={new URL(Astro.url.pathname, PROFILE.website).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, PROFILE.website).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/favicon-512.png', PROFILE.website).toString()} />

    <!-- Favicons (jankrloz Ultramarine × Obsidian) -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Academic Monograph Typography: Source Serif 4 + Libre Franklin + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Libre+Franklin:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    {showManifold && <ArchitecturalManifold />}
    <div class="vellum-overlay" aria-hidden="true"></div>

    <header class="glass-bar">
      <div class="glass-bar-inner">
        <a href="/" class="brand-mark" aria-label="JC Navarrete Home">
          <img src="/favicon.svg" alt="" width="22" height="22" />
          <span class="brand-monogram">{PROFILE.alias}</span>
        </a>
        <nav class="bar-links" aria-label="Primary links">
          <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="bar-link">
            GitHub
          </a>
          <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="bar-link">
            LinkedIn
          </a>
          <a
            href="/writing/"
            class="bar-link"
            aria-current={Astro.url.pathname.startsWith('/writing') ? 'page' : undefined}
          >
            Writing
          </a>
          <a
            href={PROFILE.cvHtml}
            class="bar-link"
            aria-current={Astro.url.pathname.startsWith('/cv') ? 'page' : undefined}
          >
            CV
          </a>
          <a href={PROFILE.cvPdf} class="bar-link-primary" download>PDF ↓</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class={shellClass}>
      <slot />
    </main>
  </body>
</html>
